[Unit]
Description=Siverteh Brain persistent desktop observatory
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/siverteh-ai/observatory/control.py watch-brain
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=8

[Install]
WantedBy=graphical-session.target
