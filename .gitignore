# Cache and logs
*.log
*.cache
**/cache/
**/.cache/

# Backup files
*.backup
*.backup-*
*~

# Temporary files
*.tmp
*.swp
*.swo
*.pyc
__pycache__/

# Exclude images EXCEPT in specific directories
*.jpg
*.png
*.jpeg
!siverteh/wallpapers/*.jpg
!siverteh/wallpapers/*.png
!siverteh/wallpapers/*.jpeg
!wlogout/icons/*.png

# Sensitive data
**/*password*
**/*secret*
**/*token*

# This file names a D-Bus provider and contains no credentials.
!/ai/dbus/org.freedesktop.secrets.service
