function luminance(value) {
    var channels = [1, 3, 5].map(function(i) { return parseInt(value.slice(i, i + 2), 16) / 255; });
    channels = channels.map(function(v) { return v <= .04045 ? v / 12.92 : Math.pow((v + .055) / 1.055, 2.4); });
    return channels[0] * .2126 + channels[1] * .7152 + channels[2] * .0722;
}
function colored(primary, secondary, tertiary, highlight, background, foreground, compact) {
    var bg = String(background);
    function ratio(value) { var a = luminance(value), b = luminance(bg); return (Math.max(a,b)+.05)/(Math.min(a,b)+.05); }
    function lift(value) {
        value = String(value);
        if (ratio(value) >= 3.4) return value;
        var target = ratio(String(foreground)) >= 3.4 ? String(foreground) : luminance(bg) < .5 ? "#ffffff" : "#000000";
        for (var step = 1; step <= 20; step++) {
            var mixed = "#";
            for (var i = 1; i < 6; i += 2) mixed += Math.round(parseInt(value.slice(i,i+2),16) + (parseInt(target.slice(i,i+2),16)-parseInt(value.slice(i,i+2),16))*step/20).toString(16).padStart(2,"0");
            if (ratio(mixed) >= 3.4) return mixed;
        }
        return target;
    }
    var p = lift(primary);
    var roles = {PRIMARY:p, SECONDARY:lift(secondary), TERTIARY:lift(tertiary), HIGHLIGHT:luminance(bg)>.5?p:String(highlight)};
    var source = compact ? compactTemplate : fullTemplate;
    for (var role in roles) source = source.replace(new RegExp("@"+role+"@", "g"), roles[role]);
    return source;
}
