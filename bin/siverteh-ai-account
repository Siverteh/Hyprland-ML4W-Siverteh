#!/usr/bin/env python3
"""Run Codex with separate authentication and shared personal guidance."""
import os
from pathlib import Path
import re
import sys

if len(sys.argv) < 2 or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,47}', sys.argv[1]):
    raise SystemExit('Usage: siverteh-ai-account ACCOUNT [Codex arguments...]')
profile = Path.home() / '.local/share/siverteh-ai/accounts' / sys.argv[1]
profile.mkdir(parents=True, exist_ok=True, mode=0o700)
profile.chmod(0o700)
guidance = profile / 'AGENTS.md'
canonical = Path.home() / '.codex/AGENTS.md'
if not guidance.exists() and canonical.exists():
    guidance.symlink_to(canonical)
env = dict(os.environ, CODEX_HOME=str(profile))
os.execvpe('codex', ['codex', *sys.argv[2:]], env)
