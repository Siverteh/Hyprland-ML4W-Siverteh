general {
    ignore_empty_input = true
}
background {
    monitor =
    path = {{wallpaper}}
    color = rgba({{surface}}ff)
    blur_passes = 3
}
input-field {
    monitor =
    size = 300, 54
    position = 0, -70
    halign = center
    valign = center
    inner_color = rgba({{surfaceContainer}}ff)
    outer_color = rgba({{primary}}ff)
    font_color = rgba({{onSurface}}ff)
    outline_thickness = 1
    rounding = 12
    dots_size = 0.2
    dots_spacing = 0.3
    fade_on_empty = false
    placeholder_text = Unlock your space
    fail_text = $FAIL
    check_color = rgba({{primary}}ff)
    fail_color = rgba({{error}}ff)
}
label {
    monitor =
    text = cmd[update:1000] date '+%H:%M'
    color = rgba({{onSurface}}ff)
    font_size = 72
    font_family = Cantarell
    position = 0, 140
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] date '+%A, %d %B'
    color = rgba({{primary}}ff)
    font_size = 16
    font_family = Cantarell
    position = 0, 65
    halign = center
    valign = center
}
