[Unit]
Description=Siverteh OS native desktop shell
PartOf=graphical-session.target
After=graphical-session.target
[Service]
Type=simple
ExecStart=%h/.local/bin/siverteh-os-shell start
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=10
[Install]
WantedBy=graphical-session.target
