[Unit]
Description=Siverteh login, resume and display readiness observer
PartOf=graphical-session.target
After=graphical-session.target
[Service]
ExecStart=/usr/bin/python3 %h/.local/share/siverteh-ai/siverteh-shell/tools/session-watch.py watch
Restart=on-failure
RestartSec=3
[Install]
WantedBy=graphical-session.target
