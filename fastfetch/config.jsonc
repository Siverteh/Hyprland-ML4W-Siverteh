{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.local/share/nacre/branding/sh.png",
    "width": 30,
    "height": 12,
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    {
      "type": "custom",
      "format": "Nacre",
      "key": "Desktop"
    },
    {
      "type": "title",
      "key": "Identity",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "System"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "wm",
      "key": "Compositor"
    },
    {
      "type": "de",
      "key": "Desktop"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "command",
      "key": "Filesystem age",
      "text": "bash \"$HOME/.config/fastfetch/system-age.sh\""
    },
    {
      "type": "cpu",
      "key": "Processor",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Storage",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}%)"
    },
    {
      "type": "colors",
      "key": "Palette",
      "symbol": "circle"
    }
  ]
}
